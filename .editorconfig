# Gemeinsame Editor-Einstellungen für alle Flavors
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# --- Bash-Flavor: shfmt liest diese Einstellungen ---
[*.{sh,bash}]
shell_variant = bash
binary_next_line = true
switch_case_indent = true
space_redirects = true

[*.bats]
shell_variant = bats
switch_case_indent = true
space_redirects = true
